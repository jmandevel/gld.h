/*
    gld.h - VERSION 3.0.1 - A header-only OpenGL debugging library
    ------------------------------------------------------------

    Created By Dan Aime Valcour (jmandevel) - https://github.com/jmandevel

    In order to use this library, include it after including your OpenGL loader
    (such as GLAD or GLEW).

        #include <glad/glad.h>
        #include <gld/gld.h>

    This library normally has no effect in release builds. You can enable gld.h
    in release builds by defining GLD_RELEASE before including the header.

    Call OpenGL functions with gld in front instead of gl:

        gldActiveTexture(GL_TEXTURE0);
        GLuint gl_program = gldCreateProgram();

    This library only works on Clang and GCC compilers. It has no effect if using MSVC.
*/

#if !defined(GLD_H)
#define GLD_H

#if !defined(GLD_DEBUG_TRAP)
#if defined(_MSC_VER)
#define GLD_DEBUG_TRAP() __debugbreak()
#elif defined(__GNUC__) || defined(__clang__)
#include <signal.h>
#define GLD_DEBUG_TRAP() raise(SIGTRAP)
#else
#define GLD_DEBUG_BREAK() ((void)0)
#endif
#endif

#if !defined(GLD_DISABLE) && (!defined(GLD_RELEASE) || defined(NDEBUG))

#if !defined(GLD_LOG_ERROR)
#include <stdio.h>
static inline int _GLD_logErrors(const char *func, const char *file, int line)
{
    GLenum error = glGetError();
    int is_ok = 1;
    while (error != GL_NO_ERROR)
    {
        fprintf(stderr, "[Opengl Error] (0x%04x): %s %s:%d\n", error, func, file, line);
        error = glGetError();
        is_ok = 0;
    }
    return is_ok;
}
#define GLD_LOG_ERRORS(func, file, line) _GLD_logErrors(func, file, line)
#endif

#if defined(__GNUC__) || defined(__clang__)
#define GLD_CALL(X)                                  \
    do                                               \
    {                                                \
        while (glGetError() != GL_NO_ERROR)          \
            ;                                        \
        X;                                           \
        if (!GLD_LOG_ERRORS(#X, __FILE__, __LINE__)) \
        {                                            \
            GLD_DEBUG_TRAP();                        \
        }                                            \
    } while (0)
#else
#define GLD_CALL(X) (X)
#endif

#if defined(__GNUC__) || defined(__clang__)
#define GLD_CALL_RET(X)                              \
    ({                                               \
        while (glGetError() != GL_NO_ERROR)          \
            ;                                        \
        __typeof__(X) _gld_out = (X);                \
        if (!GLD_LOG_ERRORS(#X, __FILE__, __LINE__)) \
        {                                            \
            GLD_DEBUG_TRAP();                        \
        }                                            \
        _gld_out;                                    \
    })
#else
#define GLD_CALL_RET(X) (X)
#endif

#else

#define GLD_LOG_ERRORS(func, file, line) ((void)0)
#define GLD_CALL(X) X
#define GLD_CALL_RET(X) (X)

#endif

@GLD_GL_CALLS@

#endif